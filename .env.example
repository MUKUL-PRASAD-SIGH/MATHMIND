# Backend
API_PORT=8000
DATABASE_URL=sqlite:///./data/mathmind.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5
MAX_IMAGE_PIXELS_SIDE=4096
CORS_ORIGINS=http://localhost:5173

# Recognition
OCR_CONFIDENCE_THRESHOLD=0.75
PRELOAD_OCR=false

# Local LLM (optional — app works without it)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Learner work is sent to OLLAMA_URL. Non-local hosts are refused at startup unless this is true.
ALLOW_REMOTE_OLLAMA=false

# Stage timeouts (seconds)
TIMEOUT_OCR=20
TIMEOUT_VERIFY=5
TIMEOUT_LLM=60

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=false

# docker compose (T8.1) — host ports, bound to 127.0.0.1 only
WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8000
# true = backend image also installs pix2tex (CPU torch, large)
WITH_ML=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmind.local/contracts/schemas/Problem.json",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Concept Id"
    },
    "prompt_latex": {
      "type": "string",
      "title": "Prompt Latex"
    },
    "expected_answer_latex": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Answer Latex"
    },
    "difficulty": {
      "type": "integer",
      "maximum": 5.0,
      "minimum": 1.0,
      "title": "Difficulty"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "concept_id",
    "prompt_latex",
    "difficulty"
  ],
  "title": "Problem"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmind.local/contracts/schemas/ExportedObject.json",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id"
    },
    "kind": {
      "type": "string",
      "title": "Kind"
    },
    "bbox": {
      "$ref": "BBox.json"
    },
    "payload": {
      "additionalProperties": true,
      "type": "object",
      "title": "Payload"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "kind",
    "bbox",
    "payload"
  ],
  "title": "ExportedObject"
}

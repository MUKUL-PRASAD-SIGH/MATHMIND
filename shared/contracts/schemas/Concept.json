{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmind.local/contracts/schemas/Concept.json",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Id"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "domain": {
      "type": "string",
      "title": "Domain"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "default": ""
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "title": "Prerequisites"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "name",
    "domain"
  ],
  "title": "Concept"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmind.local/contracts/schemas/NextAction.json",
  "properties": {
    "action": {
      "$ref": "RecommendedAction.json"
    },
    "concept_id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Concept Id"
    },
    "problem_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ],
      "title": "Problem Id"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "action",
    "concept_id",
    "reason"
  ],
  "title": "NextAction"
}
